#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Program {uint programWords[];};
layout(std430,binding=1) readonly buffer Inputs {float inputValues[];};
layout(std430,binding=2) writeonly buffer Statuses {uint statuses[];};
layout(std430,binding=3) writeonly buffer Outputs {float outputValues[];};
layout(push_constant) uniform Parameters {
 uint count;uint instructionCount;uint inputWidth;uint outputWidth;uint base;
};
#define DW_IR_WORD(i) programWords[i]
#define DW_IR_INPUT(i) inputValues[inputBase+(i)]
#define DW_IR_OUTPUT_REGISTER(i) programWords[4u*instructionCount+(i)]
#define DW_IR_OUTPUT(i) outputValues[outputBase+(i)]
#include "source_ir.inc"
void main(){
 uint lane=base+gl_GlobalInvocationID.x;
 if(lane>=count)return;
 statuses[lane]=dw_ir_execute(instructionCount,outputWidth,lane*inputWidth,lane*outputWidth);
}
